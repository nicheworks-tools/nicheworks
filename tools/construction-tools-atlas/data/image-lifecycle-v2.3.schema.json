{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nicheworks:cta:image-lifecycle:v2.3",
  "title": "Construction Tools Atlas image lifecycle",
  "description": "Structural schema; image-lifecycle-v2.3.cjs additionally enforces state graph, evidence, registry, publication and exception parity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "candidates",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "cta-image-lifecycle-v2.3"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_entry_id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_entry_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "photograph",
              "illustration"
            ]
          },
          "source_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "entry_id"
            ],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^image-wave\\d+-sources-v2\\.3\\.json$"
              },
              "entry_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "source": {
            "type": "object",
            "required": [
              "source_url",
              "source_page"
            ],
            "properties": {
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "source_page": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "source_ref"
            ],
            "not": {
              "required": [
                "source"
              ]
            }
          },
          {
            "required": [
              "source"
            ],
            "not": {
              "required": [
                "source_ref"
              ]
            }
          }
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "history"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "at",
                "actor",
                "reason",
                "candidate_id",
                "candidate_sha256",
                "hold"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unreviewed",
                    "not_required",
                    "awaiting_source",
                    "candidate",
                    "provenance_verified",
                    "subject_verified",
                    "verified",
                    "promoted"
                  ]
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
                },
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "candidate_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "candidate_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{64}$"
                },
                "hold": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "reason",
                        "resume_when"
                      ],
                      "properties": {
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        },
                        "resume_when": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "state": {
                        "enum": [
                          "candidate",
                          "provenance_verified",
                          "subject_verified",
                          "verified",
                          "promoted"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "candidate_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "candidate_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "candidate_id": {
                        "type": "null"
                      },
                      "candidate_sha256": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
