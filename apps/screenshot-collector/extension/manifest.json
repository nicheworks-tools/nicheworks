{
  "manifest_version": 3,
  "name": "NicheWorks Screenshot Collector — Capture PoC",
  "version": "0.1.0",
  "description": "Local-only screenshot capture feasibility experiment. Not production-ready.",
  "permissions": [
    "tabs",
    "scripting",
    "downloads",
    "debugger",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Screenshot Collector PoC"
  }
}
